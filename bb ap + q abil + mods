-- =============================================
RunService.Heartbeat:Connect(function()
	if not AutoParryEnabled then
		DebugLabel.Text = ""
		return
	end
	if not PlayerHasParried then return end

	local ball = GetBall()
	if not ball then
		Parried = false
		LastTarget = nil
		DebugLabel.Text = ""
		return
	end

	local currentTarget = ball:GetAttribute("target")
	if ball ~= LastBallInstance or currentTarget ~= LastTarget then
		Parried = false
		LastBallInstance = ball
		LastTarget = currentTarget
	end

	if Parried then return end
	if currentTarget ~= LocalPlayer.Name then
		DebugLabel.Text = "Мяч не мой"
		return
	end

	local char = LocalPlayer.Character
	if not char then return end
	local hrp = char:FindFirstChild("HumanoidRootPart")
	if not hrp then return end

	-- ==================== MODE 1 ====================
	if CurrentMode == 1 then
		local dist = (hrp.Position - ball.Position).Magnitude
		local zoomies = ball:FindFirstChild("zoomies")
		local speed = 65
		if zoomies then
			speed = zoomies.VectorVelocity.Magnitude
		end

		local ping = 0
		local ok, val = pcall(function()
			return Stats.Network.ServerStatsItem["Data Ping"]:GetValue()
		end)
		if ok then ping = val end

		local dynamicThreshold = Threshold + (speed * 0.18) + ((ping / 1000) * speed)

		DebugLabel.Text = string.format("Mode1 | Dist: %.1f | Thr: %.1f", dist, dynamicThreshold)

		if dist <= dynamicThreshold or dist <= 18 then
			local randomDelay = math.random(1, 8) / 1000
			task.delay(randomDelay, function()
				if UseQParryEnabled then
					PressQ()
				else
					PerformClick()
				end
				DoSpin()
			end)
			Parried = true
		end

	-- ==================== MODE 2 ====================
	else
		local data = GetApproachData(hrp, ball)

		local ping = 0
		local ok, val = pcall(function()
			return Stats.Network.ServerStatsItem["Data Ping"]:GetValue()
		end)
		if ok then ping = val / 1000 end

		local triggerTime = ping + ReactionBuffer + (data.ApproachSpeed * SpeedScale)
		if triggerTime < MinTriggerTime then
			triggerTime = MinTriggerTime
		end

		DebugLabel.Text = string.format(
			"Mode2 | Dist: %.1f | ApSpd: %.0f | ETA: %.3f | Lim: %.3f",
			data.Distance,
			data.ApproachSpeed,
			math.min(data.TimeToImpact, 9.99),
			triggerTime
		)

		local shouldParry = false

		if data.IsApproaching and data.TimeToImpact <= triggerTime then
			shouldParry = true
		end
		if data.Distance <= EmergencyDistance and data.IsApproaching then
			shouldParry = true
		end

		if shouldParry then
			Parried = true
			if UseQParryEnabled then
				PressQ()
			else
				PerformClick()
			end
			DoSpin()
		end
	end
end)
