-- GET BALL
-- =============================================
local function GetBall()
	local ws = game:GetService("Workspace")
	for _, folderName in pairs({"Balls", "TrainingBalls"}) do
		local folder = ws:FindFirstChild(folderName)
		if folder then
			local ball = folder:FindFirstChildOfClass("Part")
			if ball then return ball end
		end
	end
	return nil
end

-- =============================================
-- ВЕКТОРНЫЙ РАСЧЁТ СБЛИЖЕНИЯ
-- =============================================
local function GetBallVelocity(ball)
	local zoomies = ball:FindFirstChild("zoomies")
	if zoomies and zoomies:IsA("LinearVelocity") then
		return zoomies.VectorVelocity
	end
	if ball:IsA("BasePart") then
		return ball.AssemblyLinearVelocity
	end
	return Vector3.new(0, 0, 0)
end

local function GetApproachData(hrp, ball)
	local toPlayer = hrp.Position - ball.Position
	local distance = toPlayer.Magnitude
	if distance < 0.001 then
		return {
			IsApproaching = true,
			ApproachSpeed = 1,
			TimeToImpact = 0,
			Distance = distance
		}
	end
	local dirToPlayer = toPlayer.Unit
	local ballVelocity = GetBallVelocity(ball)
	local approachSpeed = ballVelocity:Dot(dirToPlayer)

	if approachSpeed <= 0 then
		return {
			IsApproaching = false,
			ApproachSpeed = approachSpeed,
			TimeToImpact = math.huge,
			Distance = distance
		}
	end

	return {
		IsApproaching = true,
		ApproachSpeed = approachSpeed,
		TimeToImpact = distance / approachSpeed,
		Distance = distance
	}
end

-- =============================================
-- ОСНОВНОЙ УЛЬТРА-БЫСТРЫЙ ЦИКЛ AUTO PARRY
-- =============================================
RunService.Heartbeat:Connect(function()
	if not AutoParryEnabled then
		DebugLabel.Text = ""
		return
	end
	if not PlayerHasParried then return end

	local ball = GetBall()
	if not ball then
		Parried = false
		LastTarget = nil
		DebugLabel.Text = ""
		return
	end

	local currentTarget = ball:GetAttribute("target")
	if ball ~= LastBallInstance or currentTarget ~= LastTarget then
		Parried = false
		LastBallInstance = ball
		LastTarget = currentTarget
	end

	if Parried then return end
	if currentTarget ~= LocalPlayer.Name then
		DebugLabel.Text = "Мяч не мой"
		return
	end

	local char = LocalPlayer.Character
	if not char then return end
	local hrp = char:FindFirstChild("HumanoidRootPart")
	if not hrp then return end

	local data = GetApproachData(hrp, ball)

	-- Получаем пинг
	local ping = 0
	local ok, val = pcall(function()
		return Stats.Network.ServerStatsItem["Data Ping"]:GetValue()
	end)
	if ok then ping = val / 1000 end

	-- Динамический порог времени
	local triggerTime = ping + ReactionBuffer + (data.ApproachSpeed * SpeedScale)
	if triggerTime < MinTriggerTime then
		triggerTime = MinTriggerTime
	end

	-- Дебаг-данные
	DebugLabel.Text = string.format(
		"Dist: %.1f | ApSpd: %.0f | ETA: %.3f | Limit: %.3f",
		data.Distance,
		data.ApproachSpeed,
		math.min(data.TimeToImpact, 9.99),
		triggerTime
	)

	local shouldParry = false

	-- 1. Основное условие срабатывания по физическому расчету времени
	if data.IsApproaching and data.TimeToImpact <= triggerTime then
		shouldParry = true
	end

	-- 2. Аварийный отбив при быстром сближении вплотную
	if data.Distance <= EmergencyDistance and data.IsApproaching then
		shouldParry = true
	end

	if shouldParry then
		Parried = true

		if UseQParryEnabled then
			PressQ()
		else
			PerformClick()
		end

		DoSpin()
	end
end)
