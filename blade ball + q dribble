-- =============================================
-- СЛАЙДЕРЫ (ЛОГИКА И ФИКС ПРИЛИПАНИЯ К КУРСОРУ)
-- =============================================

-- ReactionBuffer: min=0.01, max=0.5, step=0.005
local RB_MIN, RB_MAX, RB_STEP = 0.01, 0.5, 0.005
-- EmergencyDistance: min=1, max=100, step=1
local ED_MIN, ED_MAX, ED_STEP = 1, 100, 1

local function UpdateRBDisplay()
	RBLabel.Text = "ReactionBuffer: " .. string.format("%.3f", ReactionBuffer)
	RBInputBox.Text = string.format("%.3f", ReactionBuffer)
	local frac = math.clamp((ReactionBuffer - RB_MIN) / (RB_MAX - RB_MIN), 0, 1)
	RBSliderFill.Size = UDim2.new(frac, 0, 1, 0)
end

local function UpdateEDDisplay()
	EDLabel.Text = "EmergencyDist: " .. string.format("%.1f", EmergencyDistance)
	EDInputBox.Text = string.format("%.1f", EmergencyDistance)
	local frac = math.clamp((EmergencyDistance - ED_MIN) / (ED_MAX - ED_MIN), 0, 1)
	EDSliderFill.Size = UDim2.new(frac, 0, 1, 0)
end

local function SetReactionBuffer(val)
	ReactionBuffer = math.clamp(val, RB_MIN, RB_MAX)
	ReactionBuffer = math.floor(ReactionBuffer / RB_STEP + 0.5) * RB_STEP
	ReactionBuffer = math.clamp(ReactionBuffer, RB_MIN, RB_MAX)
	UpdateRBDisplay()
end

local function SetEmergencyDistance(val)
	EmergencyDistance = math.clamp(val, ED_MIN, ED_MAX)
	EmergencyDistance = math.floor(EmergencyDistance / ED_STEP + 0.5) * ED_STEP
	EmergencyDistance = math.clamp(EmergencyDistance, ED_MIN, ED_MAX)
	UpdateEDDisplay()
end

-- Кнопки +/-
RBMinusBtn.MouseButton1Click:Connect(function()
	SetReactionBuffer(ReactionBuffer - RB_STEP)
end)
RBPlusBtn.MouseButton1Click:Connect(function()
	SetReactionBuffer(ReactionBuffer + RB_STEP)
end)
EDMinusBtn.MouseButton1Click:Connect(function()
	SetEmergencyDistance(EmergencyDistance - ED_STEP)
end)
EDPlusBtn.MouseButton1Click:Connect(function()
	SetEmergencyDistance(EmergencyDistance + ED_STEP)
end)

-- Ввод вручную
RBInputBox.FocusLost:Connect(function(enterPressed)
	local num = tonumber(RBInputBox.Text)
	if num then
		SetReactionBuffer(num)
	else
		UpdateRBDisplay()
	end
end)

EDInputBox.FocusLost:Connect(function(enterPressed)
	local num = tonumber(EDInputBox.Text)
	if num then
		SetEmergencyDistance(num)
	else
		UpdateEDDisplay()
	end
end)

-- Начало перетаскивания (Mouse Down)
RBSliderButton.MouseButton1Down:Connect(function()
	RBDragging = true
end)

EDSliderButton.MouseButton1Down:Connect(function()
	EDDragging = true
end)

-- Остановка перетаскивания глобально по всей игре (Mouse Up)
UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		RBDragging = false
		EDDragging = false
	end
end)

-- Обновление позиции ползунка во время зажатия
RunService.RenderStepped:Connect(function()
	if RBDragging then
		local mousePos = UserInputService:GetMouseLocation()
		local absPos = RBSliderBG.AbsolutePosition
		local absSize = RBSliderBG.AbsoluteSize
		local frac = math.clamp((mousePos.X - absPos.X) / absSize.X, 0, 1)
		local val = RB_MIN + frac * (RB_MAX - RB_MIN)
		SetReactionBuffer(val)
	end
	if EDDragging then
		local mousePos = UserInputService:GetMouseLocation()
		local absPos = EDSliderBG.AbsolutePosition
		local absSize = EDSliderBG.AbsoluteSize
		local frac = math.clamp((mousePos.X - absPos.X) / absSize.X, 0, 1)
		local val = ED_MIN + frac * (ED_MAX - ED_MIN)
		SetEmergencyDistance(val)
	end
end)

-- Инициализация дисплея слайдеров
UpdateRBDisplay()
UpdateEDDisplay()

