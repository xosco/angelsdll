local function ToggleESP()
	AbilityESPEnabled = not AbilityESPEnabled
	if not AbilityESPEnabled then
		-- Очистка тегов
		for _, p in pairs(Players:GetPlayers()) do
			if p.Character and p.Character:FindFirstChild("Head") then
				local tag = p.Character.Head:FindFirstChild("AbilityTag")
				if tag then tag:Destroy() end
			end
		end
	end
	UpdateGUI()
end

local function ToggleSpin()
	SpinEnabled = not SpinEnabled
	UpdateGUI()
end

-- =============================================
-- КРУТИЛКА 🌀
-- =============================================
local function DoSpin()
	if not SpinEnabled then return end
	if IsSpinning then return end

	local char = LocalPlayer.Character
	if not char then return end
	local hrp = char:FindFirstChild("HumanoidRootPart")
	if not hrp then return end

	IsSpinning = true

	task.spawn(function()
		local spinSteps = 30
		local stepAngle = 360 / spinSteps
		local originalCFrame = hrp.CFrame

		for i = 1, spinSteps do
			if not char or not char.Parent then break end
			if not hrp or not hrp.Parent then break end

			local angle = math.rad(stepAngle * i)
			hrp.CFrame = CFrame.new(hrp.Position) * CFrame.Angles(0, angle, 0)
			RunService.RenderStepped:Wait()
		end

		if hrp and hrp.Parent then
			hrp.CFrame = CFrame.new(hrp.Position) * CFrame.Angles(0, math.rad(360), 0) * (originalCFrame - originalCFrame.Position)
		end

		IsSpinning = false
	end)
end

