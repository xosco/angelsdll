-- ABILITY ESP ЛОГИКА
-- =============================================
local function FetchAbility(p)
	local a = p:GetAttribute("Ability") or p:GetAttribute("EquippedAbility") or p:GetAttribute("SelectedAbility")
	if not a then
		local l = p:FindFirstChild("leaderstats")
		if l and l:FindFirstChild("Ability") then
			a = l.Ability.Value
		end
	end
	return (a and tostring(a) ~= "") and tostring(a) or "???"
end

task.spawn(function()
	while true do
		if AbilityESPEnabled then
			for _, p in pairs(Players:GetPlayers()) do
				if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("Head") then
					local head = p.Character.Head
					local tag = head:FindFirstChild("AbilityTag")
					if not tag then
						tag = Instance.new("BillboardGui")
						tag.Name = "AbilityTag"
						tag.Size = UDim2.new(0, 120, 0, 30)
						tag.StudsOffset = Vector3.new(0, 3, 0)
						tag.AlwaysOnTop = true
						tag.Parent = head

						local label = Instance.new("TextLabel")
						label.Name = "AbilityLabel"
						label.Size = UDim2.new(1, 0, 1, 0)
						label.BackgroundTransparency = 1
						label.Font = Enum.Font.SourceSansBold
						label.TextSize = 20
						label.TextStrokeTransparency = 0
						label.TextColor3 = Color3.fromRGB(255, 255, 100)
						label.Parent = tag
					end
					local label = tag:FindFirstChild("AbilityLabel")
					if label then
						label.Text = FetchAbility(p)
						label.Visible = true
					end
				end
			end
		else
			for _, p in pairs(Players:GetPlayers()) do
				if p.Character and p.Character:FindFirstChild("Head") then
					local tag = p.Character.Head:FindFirstChild("AbilityTag")
					if tag then
						local label = tag:FindFirstChild("AbilityLabel")
						if label then label.Visible = false end
					end
				end
			end
		end
		task.wait(1)
	end
end)

-- =============================================
-- ОБРАБОТКА ВВОДА (БИНДЫ + ЛКМ)
-- =============================================
UserInputService.InputBegan:Connect(function(input, gp)
	if gp then return end

	-- Если ждём нажатия для перебинда
	if CurrentBinding and input.UserInputType == Enum.UserInputType.Keyboard then
		if CurrentBinding == "toggle" then
			ToggleKey = input.KeyCode
		elseif CurrentBinding == "reset" then
			ResetKey = input.KeyCode
		elseif CurrentBinding == "esp" then
			ESPKey = input.KeyCode
		elseif CurrentBinding == "spin" then
			SpinKey = input.KeyCode
		end
		CurrentBinding = nil
		UpdateGUI()
		return
	end

	-- Обычные бинды
	if input.UserInputType == Enum.UserInputType.Keyboard then
		if input.KeyCode == ToggleKey then
			ToggleAutoParry()
		elseif input.KeyCode == ResetKey then
			ResetFirstParry()
		elseif input.KeyCode == ESPKey then
			ToggleESP()
		elseif input.KeyCode == SpinKey then
			ToggleSpin()
		end
	end

	-- ЛКМ для первого удара
	if input.UserInputType == Enum.UserInputType.MouseButton1 and not PlayerHasParried then
		local mousePos = UserInputService:GetMouseLocation()
		local guiObj = ScreenGui:GetGuiObjectsAtPosition(mousePos.X, mousePos.Y)

		if #guiObj == 0 or (#guiObj == 1 and guiObj == ScreenGui) then
			if AutoParryEnabled then
				PlayerHasParried = true
				Parried = false
				LastTarget = nil
				ResetStatus.Text = ""
				UpdateGUI()
			end
		end
	end
end)

