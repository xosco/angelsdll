end

local function ResetFirstParry()
	PlayerHasParried = false
	Parried = false
	LastTarget = nil
	LastBallInstance = nil
	ResetStatus.Text = "ЛКМ сброшен! Кликни заново."
	ResetStatus.TextColor3 = Color3.fromRGB(255, 160, 0)
	UpdateGUI()
	task.delay(3, function()
		ResetStatus.Text = ""
	end)
